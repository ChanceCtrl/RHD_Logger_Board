include "rhd_common.fbs";

namespace RHDResponses;

table RawResult {
  timestamp_us:uint64 = 0;
  command_type:RHDCommon.CommandType = 0;
  register:uint8 = 0;
  rhd_a:uint8 = 0;
  rhd_b:uint8 = 0;
}

table CalibrateResult {
  calibration_done:bool = 0;
}

table ReadWriteResult {
  timestamp_us:uint64 = 0;
  command_type:RHDCommon.CommandType = 4;
  register:uint8 = 0;
  rhd_a:uint8 = 0;
  rhd_b:uint8 = 0;
}

