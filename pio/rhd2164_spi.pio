.program rhd2164_tx
.side_set 2

; side bit 0 = SCLK
; side bit 1 = CSn
;
; MOSI is OUT pin 0
;
; Sends:
;   16 MOSI bits
; Generates:
;   16 clocks
;
; IRQ0 = transaction start
; IRQ1 = just before CS rises

.wrap_target

entry:
    pull block          side 0b10     ; idle: CS high, SCLK low

    set x, 15
    irq 0

bitloop:
    out pins, 1         side 0b00 [1] ; output bit, SCLK low, CS asserted
    nop                 side 0b01 [1] ; SCLK high
    jmp x-- bitloop     side 0b00      ; SCLK low

    irq 1                              ; tell RX SM to capture final bit
    nop                 side 0b10 [1] ; CS rises

.wrap



.program rhd2164_rx

; MISO is IN pin 0
;
; Captures:
;   32 edge samples
;   +1 final sample on CS rise
;
; First sample is garbage per datasheet.

.wrap_target

entry:
    wait 1 irq 0

    set x, 31

capture_loop:
    in pins, 1
    jmp x-- capture_loop

    push block

    wait 1 irq 1

    in pins, 1
    push block

    jmp entry

.wrap
