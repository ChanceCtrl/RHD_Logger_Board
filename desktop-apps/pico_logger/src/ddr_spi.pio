.pio_version 0 // only requires PIO version 0

.program ddr_spi_tx
.side_set 1

.wrap_target
    ; Wait for a 32-bit long input fella
    pull block side 1

    ; We only care about the lower 16 bits
    set x, 15 side 1

    ; Now start, and wait an additional clock cycle
    set pins, 0 side 0 [1]

bitloop:
    ; MOSI changes while sclk is low
    out pins, 1 side 0 [1]

    ; Wait for 3 PIO clock cycles
    nop side 1 [2]

    jmp x-- bitloop side 0

    ; -- Only after the 16th edge --
    ; Wait another 2 cycles
    nop side 0 [1]

    ; Get B0 and then do the t_csoff wait
    set pins, 1 side 0 [15] ; 16 cycles
    nop side 0 [15] ; 16 cycles, 32 total
    nop side 0 [2] ; 3 cycles, 35 total

.wrap


.program ddr_spi_rx
.wrap_target

wait_cs_low:
    wait 0 gpio 0

    ; The first edge has no data
    wait 1 gpio 0 [1]
    in null, 1

    ; A15
    wait 0 gpio 0 [1]
    in pins, 1

    ; 15 more loops to go
    set x, 14

bitloop: 
    wait 1 gpio 0 [1]
    in pins, 1 ; RHD_B bit X

    wait 0 gpio 0 [1]
    in pins, 1 ; RHD_A bit X-1

    jmp x-- bitloop

    ; Final bits

    wait 1 gpio 0 [1]
    in pins, 1 ; RHD_B bit 1

    wait 0 gpio 0 [1]
    in pins, 1 ; RHD_A bit 0

    ; CS should be rising 

    wait 1 gpio 0 [1]
    in pins, 1 ; RHD_B bit 0

    ; We have a full frame, congrats
    push block

.wrap
